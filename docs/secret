#!/usr/bin/env bash

URL="${1:-}"
KEY="${2:-}"

if [ -z "$URL" ] || [ -z "$KEY" ]; then
  echo ""
  echo "  shellshock.sh — receive a secret"
  echo "  ────────────────────────────────"
  echo ""
  echo "  Usage: curl -sL shellshock.sh/secret | bash -s -- <url> <key>"
  echo ""
  echo "  Both the URL and key are provided by the sender."
  echo ""
  exit 1
fi

if ! command -v openssl &>/dev/null; then
  echo "  Error: openssl is required but not found." >&2
  exit 1
fi

if ! command -v curl &>/dev/null; then
  echo "  Error: curl is required but not found." >&2
  exit 1
fi

BLOB=$(curl -sf -H "ngrok-skip-browser-warning: 1" "$URL") || {
  echo "" >&2
  echo "  Failed to retrieve secret." >&2
  echo "  It may have expired or already been retrieved." >&2
  echo "" >&2
  exit 1
}

if [ -z "$BLOB" ]; then
  echo "  Failed to retrieve secret — empty response." >&2
  exit 1
fi

PLAIN=$(echo "$BLOB" | openssl enc -aes-256-cbc -d -a -md sha256 -pass "pass:$KEY" 2>/dev/null) || {
  echo "" >&2
  echo "  Decryption failed — wrong key or corrupted data." >&2
  echo "" >&2
  exit 1
}

printf '%s\n' "$PLAIN"
