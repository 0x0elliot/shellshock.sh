{
  "name": "shellshock.sh-shared",
  "version": "0.1.1",
  "description": "Shared protocol types and command classification for shellshock.sh",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "shellshock",
    "remote-debugging",
    "protocol"
  ],
  "author": "Aditya Sinha",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0x0elliot/shellshock.sh.git",
    "directory": "packages/shared"
  },
  "homepage": "https://github.com/0x0elliot/shellshock.sh",
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^4.1.5"
  }
}
