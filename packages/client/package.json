{
  "name": "shellshock-client",
  "version": "0.1.1",
  "description": "Client for shellshock.sh — approve and execute remote debug commands in your terminal",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "shellshock-client": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "npm run build -w shellshock.sh-shared && tsx src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "shellshock",
    "remote-debugging",
    "terminal",
    "tui",
    "support",
    "command-approval"
  ],
  "author": "Aditya Sinha",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0x0elliot/shellshock.sh.git",
    "directory": "packages/client"
  },
  "homepage": "https://github.com/0x0elliot/shellshock.sh",
  "dependencies": {
    "shellshock.sh-shared": "^0.1.1",
    "better-sqlite3": "^11.8.1",
    "ink": "^5.1.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "node-pty": "^1.1.0",
    "react": "^18.3.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.19.17",
    "@types/react": "^18.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
