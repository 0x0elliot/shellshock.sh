{
  "name": "shellshock.sh",
  "version": "0.1.0",
  "description": "Remote debugging server — securely request shell commands on a customer's machine with per-command approval",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "bin": {
    "shellshock": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "shellshock",
    "remote-debugging",
    "terminal",
    "tui",
    "support",
    "ssh-alternative",
    "command-approval"
  ],
  "author": "Aditya Sinha",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0x0elliot/shellshock.sh.git",
    "directory": "packages/server"
  },
  "homepage": "https://github.com/0x0elliot/shellshock.sh",
  "dependencies": {
    "shellshock.sh-shared": "0.1.0",
    "better-sqlite3": "^11.0.0",
    "express": "^4.21.0",
    "ink": "^5.1.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "nanoid": "^5.0.0",
    "react": "^18.3.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
